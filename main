local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

if CoreGui:FindFirstChild("Voxels_XRay_V2") then
    CoreGui.Voxels_XRay_V2:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Voxels_XRay_V2"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local ToggleButton = Instance.new("TextButton")
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
ToggleButton.Position = UDim2.new(0, 50, 0, 150)
ToggleButton.Size = UDim2.new(0, 160, 0, 45)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Text = "🔮 X-Ray Voxel [OFF]"
ToggleButton.TextColor3 = Color3.fromRGB(255, 50, 50)
ToggleButton.TextSize = 14
ToggleButton.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

local IsActive = false
local StoredParts = {}

ToggleButton.MouseButton1Click:Connect(function()
    IsActive = not IsActive
    
    if IsActive then
        ToggleButton.Text = "🔮 X-Ray Voxel [ON]"
        ToggleButton.TextColor3 = Color3.fromRGB(50, 255, 50)
        
        -- Quét toàn bộ workspace tìm khối block môi trường
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local name = obj.Name:lower()
                -- Ẩn bớt các khối đất, đá thông thường để lộ không gian bên trong
                if name:find("dirt") or name:find("stone") or name:find("rock") or name:find("block") then
                    if obj.Transparency < 0.8 then
                        StoredParts[obj] = obj.Transparency
                        obj.Transparency = 0.85
                    end
                end
            end
        end
    else
        ToggleButton.Text = "🔮 X-Ray Voxel [OFF]"
        ToggleButton.TextColor3 = Color3.fromRGB(255, 50, 50)
        
        -- Khôi phục lại trạng thái ban đầu
        for obj, trans in pairs(StoredParts) do
            if obj and obj.Parent then
                obj.Transparency = trans
            end
        end
        StoredParts = {}
    end
end)
